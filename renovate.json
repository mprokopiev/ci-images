{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate config. Automerge is on; each rule below carves out an exception.",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "pre-commit": {
    "enabled": true
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Majors always need a human",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Flake inputs move the whole dev shell: grouped and manual",
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix flake",
      "automerge": false
    },
    {
      "description": "Actions are manual by default",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "description": "Official actions are trusted upstream",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Renovate itself: weekly, grouped",
      "matchPackageNames": [
        "renovatebot/pre-commit-hooks"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "extends": [
        "schedule:weekly"
      ],
      "groupName": "renovate",
      "automerge": true
    }
  ]
}
